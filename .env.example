# ==============================================================================
# FinTechFlow - Environment Configuration Template
# ==============================================================================
# IMPORTANT: This is a template with safe placeholder values for educational use.
# NEVER commit real production secrets, credentials, or API keys to version control.
# Copy this file to '.env' for local development only (which is git-ignored).
# ==============================================================================

# Application Metadata
APP_NAME=FinTechFlow
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server Settings
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=0

# Security (Development placeholder - override securely in production/staging)
SECRET_KEY=dev-insecure-secret-key-change-in-production-vault

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
